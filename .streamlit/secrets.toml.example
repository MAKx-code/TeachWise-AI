# .streamlit/secrets.toml.example
# Copy to .streamlit/secrets.toml for local Streamlit dev (never commit secrets.toml)
# On Streamlit Community Cloud, add these in the Secrets section of the app dashboard.
#
# Note: streamlit_app.py uses python-dotenv to load .env — secrets.toml is optional.
# For Streamlit Community Cloud, set secrets here and they appear as env vars.

WATSONX_API_KEY = "your_ibm_watsonx_api_key_here"
WATSONX_PROJECT_ID = "your_project_id_here"
WATSONX_URL = "https://us-south.ml.cloud.ibm.com"
WATSONX_MODEL_ID = "ibm/granite-3-8b-instruct"
SECRET_KEY = "change_this_to_a_random_secret_key"
DATABASE_URL = "sqlite:///teachwise.db"
